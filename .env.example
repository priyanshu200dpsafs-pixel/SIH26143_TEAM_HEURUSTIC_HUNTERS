# AEGIS-SAR Production Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000

# Copernicus Data Space Ecosystem (CDSE) OData Provider
# Obtain credentials from: https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=your_copernicus_client_id_here
CDSE_CLIENT_SECRET=your_copernicus_client_secret_here
COPERNICUS_API_KEY=your_copernicus_api_key_optional

# AIS Live Stream Provider (Optional - Platform defaults to Replay/Benchmark mode)
AIS_API_KEY=your_live_ais_feed_key_here
AIS_STREAM_ENDPOINT=wss://live.aisstream.io/v1/stream
